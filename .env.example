# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Configuration (for approval requests via Slack)
# SLACK_WEBHOOK_URL: Incoming Webhook URL for posting messages
#   - Get from: https://api.slack.com/apps -> Your App -> Incoming Webhooks
#   - Click "Add New Webhook to Workspace" and select your channel
#   - Copy the full Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# SLACK_BOT_TOKEN: Bot token for reading reactions/messages (optional)
#   - Get from: https://api.slack.com/apps -> Your App -> OAuth & Permissions
#   - Copy "Bot User OAuth Token" (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# BASE_URL: Public URL where your API is accessible
#   - Used to construct approval links in Slack messages
#   - For local testing with ngrok: https://your-ngrok-url.ngrok.io
#   - For production: https://your-domain.com
BASE_URL=https://example.ngrok.io

# Analytics Configuration
GA4_PROPERTY_ID=your_ga4_property_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
MAX_REVISION_ITERATIONS=5
WEBSOCKET_MAX_SIZE=10485760

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
